<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="nt:unstructured">
    <content jcr:primaryType="nt:unstructured">
        <items jcr:primaryType="nt:unstructured">
            <tabs jcr:primaryType="nt:unstructured">
                <items jcr:primaryType="nt:unstructured">
                    <!--
                        New sibling tab, added via Sling Resource Merger.
                        Only this node is new - the inherited "Properties"/"Link"
                        tabs from core/wcm/components/title/v3/title (and
                        ecm/components/title) are left completely untouched.
                    -->
                    <ecmTitleOptions
                        jcr:primaryType="nt:unstructured"
                        jcr:title="ECM Title"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <titlePrefix
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Title Prefix"
                                fieldDescription="Optional prefix prepended to the title, e.g. 'ECM - Investment Solutions'."
                                name="./titlePrefix"/>
                        </items>
                    </ecmTitleOptions>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
