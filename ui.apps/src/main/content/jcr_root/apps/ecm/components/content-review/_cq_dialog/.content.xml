<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Review Training Page"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <columns
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <column
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <decision
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                emptyOption="{Boolean}true"
                                emptyText="Select a decision"
                                fieldDescription="Approve the page or request changes."
                                fieldLabel="Review Decision"
                                name="./jcr:content/workflowReviewDecision"
                                required="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <approved
                                        jcr:primaryType="nt:unstructured"
                                        text="Approved"
                                        value="APPROVED"/>
                                    <changesRequired
                                        jcr:primaryType="nt:unstructured"
                                        text="Changes Required"
                                        value="CHANGES_REQUIRED"/>
                                </items>
                            </decision>
                            <comments
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                emptyText="Enter your review comments"
                                fieldDescription="Explain the decision or describe the required changes."
                                fieldLabel="Reviewer Comments"
                                maxlength="{Long}500"
                                name="./jcr:content/workflowReviewComments"
                                required="{Boolean}true"
                                rows="{Long}5"/>
                        </items>
                    </column>
                </items>
            </columns>
        </items>
    </content>
</jcr:root>
